!/docs/images/before-fullscreen.jpg
!/docs/images/after-home.jpg
/scripts/*
!/scripts/check-ui.mjs
!/scripts/optimize-wallpaper.ps1
!/scripts/prepare-readme-photos.ps1
/tests/*
!/tests/luna.test.mjs
/public/identity/
/assets/source/coast-blue-hour.png
