# Dependencies and generated app packages
node_modules/
dist/
*.ipk

# Device fingerprints, inventories, pairing credentials, and trust pins
docs/fingerprint*.txt
docs/fingerprint*.json

# Downloaded research code/packages and future device backups
.research/
/backups/

# Local secrets and SSH material
.env
.env.*
!.env.example
!.env.*.example
.ssh/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*_dec
*_webos
*_ed25519

# Runtime and OS caches
*.log
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
/Microsoft/

# Private device operations and session history. Keep the public checkout focused
# on the launcher, portable checks and the sanitized project case study.
